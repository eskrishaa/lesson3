print("4 - включить фонарь")
print("5 - подойти к приемной стойке")
print()

# --- Выбор действия --------------------------------
action = input()
match action:
    case "1":
        print("Вы осмотрелись. Комната пуста, только пыль на полу.")
    case "2":
        endurance = endurance - 2
        print("Вы осторожно идёте вперёд. Пол скрипит под ногами.")
    case "3":
        endurance = endurance - 3
        print("Вы присели на ржавый железный стул и вздохнули.")
    case "4":
        endurance = endurance - 4
        print("Вы достали из левого кармана фонарь,вставили в него батарейки и включили его.")
    case "5":
        endurance = endurance - 5
        print("Вы подошли приемной стойке и начали просматривать все полки.")
    case _:
        print("Такого действия нет!")

